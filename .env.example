# 复制为 .env 后填写；.env 只保存在本机，不要提交到 Git。

# ===== s01-s09：Anthropic Messages API =====
ANTHROPIC_API_KEY=
MODEL_ID=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=0

# ===== s07：自动上下文压缩 =====
# s07-s12 必填：当前模型/服务实际支持的上下文窗口，查服务配置后填写，不按模型名字猜测。
MODEL_CONTEXT_WINDOW_TOKENS=
# 接近模型窗口时预留 Token；触发点 = 模型窗口 - 预留。
SESSION_COMPACTION_RESERVE_TOKENS=16384
# 压缩时保留近期原始消息的近似 Token 预算；必须小于触发点。
SESSION_COMPACTION_KEEP_RECENT_TOKENS=20000
# 摘要输出上限可单独设置；省略时默认取预留预算的 80%，须符合模型输出上限。
# 摘要的 Anthropic 请求会显式关闭思考；兼容服务必须支持该参数，预算本身不能保证正文出现。
# SESSION_COMPACTION_SUMMARY_MAX_TOKENS=4096

# ===== s11：可选运行保护 =====
# 0 表示不设置固定轮数上限；正整数只限制回答请求，不计摘要请求。
AGENT_MAX_ROUNDS=0

# 如果使用 Anthropic 兼容代理，可填写自定义地址；官方地址通常无需填写。
# ANTHROPIC_BASE_URL=

# ===== s10：模型 Provider =====
# Anthropic 使用 anthropic；OpenAI、DeepSeek 等 Chat Completions 兼容接口使用 openai-compatible。
MODEL_PROVIDER=anthropic

# 使用 openai-compatible 时填写；Anthropic 模式可留空。
# MODEL_API_KEY=your-key
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_ID=your-model
