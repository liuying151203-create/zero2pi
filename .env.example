# 复制为 .env 后填写；.env 只保存在本机，不要提交到 Git。

# ===== s01-s09：Anthropic Messages API =====
ANTHROPIC_API_KEY=
MODEL_ID=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=0

# ===== 当前第七章：自动上下文压缩 =====
# 活跃上下文超过该字符数时，模型会生成摘要；字符数是易观察的近似值，不是精确 token 数。
SESSION_COMPACTION_MAX_CHARS=24000
# 压缩后最近消息最多占用的字符数；不得超过总阈值的一半。
SESSION_COMPACTION_KEEP_RECENT_CHARS=12000
# 生成会话摘要时允许模型输出的最大 token 数。
# 摘要的 Anthropic 请求会显式关闭思考；兼容服务必须支持该参数，预算本身不能保证正文出现。
SESSION_COMPACTION_SUMMARY_MAX_TOKENS=1024

# 如果使用 Anthropic 兼容代理，可填写自定义地址；官方地址通常无需填写。
# ANTHROPIC_BASE_URL=

# ===== s10：模型 Provider =====
# Anthropic 使用 anthropic；OpenAI、DeepSeek 等 Chat Completions 兼容接口使用 openai-compatible。
MODEL_PROVIDER=anthropic

# 使用 openai-compatible 时填写；Anthropic 模式可留空。
# MODEL_API_KEY=your-key
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_ID=your-model
