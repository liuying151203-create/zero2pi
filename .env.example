# 复制为 .env 后填写；.env 只保存在本机，不要提交到 Git。

# ===== 当前第一章：Anthropic Messages API =====
# 当前 s01_agent_loop/code.py 使用 Anthropic 客户端。
ANTHROPIC_API_KEY=
MODEL_ID=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=0

# ===== 当前第七章：自动上下文压缩 =====
# 活跃上下文超过该字符数时，模型会生成摘要；字符数是易观察的近似值，不是精确 token 数。
SESSION_COMPACTION_MAX_CHARS=24000
# 压缩后保留最近的消息数；工具调用和对应结果位于边界时会一起保留。
SESSION_COMPACTION_KEEP_RECENT_MESSAGES=6
# 生成会话摘要时允许模型输出的最大 token 数。
SESSION_COMPACTION_SUMMARY_MAX_TOKENS=1024

# 如果使用 Anthropic 兼容代理，可填写自定义地址；官方地址通常无需填写。
# ANTHROPIC_BASE_URL=

# ===== 后续 provider adapter：DeepSeek / OpenAI 兼容接口 =====
# 当前第一章不能仅靠修改环境变量切换到此协议，后续章节会加入适配层。
# MODEL_PROVIDER=openai-compatible
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.deepseek.com/v1
# MODEL_ID=deepseek-chat
# 可选模型示例：deepseek-chat、deepseek-reasoner
